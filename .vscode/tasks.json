{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: serve",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/toolchain.cjs",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "8080"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE|Starting",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:8080"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
